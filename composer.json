{
    "name": "hampel/wback",
    "description": "Website backup for a server hosting many sites: databases, files, cloud storage and retention, driven by a TOML inventory.",
    "keywords": ["backup", "mysqldump", "rclone", "console", "cli"],
    "homepage": "https://github.com/hampel/wback",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hampel/wback/issues",
        "source": "https://github.com/hampel/wback"
    },
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/log": "^13.0",
        "laravel-zero/framework": "^13.0",
        "yosymfony/toml": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["wback"]
}

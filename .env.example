
# Path to the backup sites TOML file
#SITES_TOML_PATH=/etc/wback.toml

# Storage path defaults to current working directory - use this to over-ride the default
#LARAVEL_STORAGE_PATH=

# Timezone used for datestamped backup filenames and everything this app reports.
# Configured in config/backup.php rather than config/app.php, because app:build
# evaluates config/app.php on the build machine and compiles the result in as literals -
# an env() call in that file is frozen at build time, whatever a .env next to the binary
# says. This one works in a built binary.
#APP_TIMEZONE=Australia/Sydney

# The BACKUP_*_PATH settings below name the executables used to do the work.
# Everything else is quoted before it reaches the shell, but these are inserted
# into the command line as written - so they may carry options of their own, eg:
#
#     BACKUP_GZIP_PATH="nice -n 19 /bin/gzip"
#     BACKUP_RCLONE_PATH="/usr/bin/rclone --config /etc/rclone.conf"
#
# which is the tidiest way to point rclone at a config file when the backups run
# as a user without one of its own. They must never be built out of anything but
# your own configuration.

# Path to mysqldump executable
#BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump

# Default character set for database
#BACKUP_DEFAULT_CHARSET=utf8mb4

# Whether to use --hex-blob option on database dumps
#BACKUP_MYSQLDUMP_HEXBLOB=true

# Whether to dump with --single-transaction.
# Without it mysqldump read-locks every table in the database for the whole dump,
# which takes the site offline for as long as that takes. With it the dump comes
# from a consistent snapshot and writes carry on - but only transactional (InnoDB)
# tables are covered, so a schema with MyISAM tables holding data you care about
# wants this off, or those tables converted.
# Override per site in the TOML file with: single_transaction = false
#BACKUP_MYSQLDUMP_SINGLE_TRANSACTION=true

# Extra options for every mysqldump command, inserted as written (see the note above).
# Somewhere to put the compatibility options a given server needs, eg --no-tablespaces
# when the dump user has no PROCESS privilege, --column-statistics=0 for a MySQL 8
# client dumping an older server, or --set-gtid-purged=OFF to restore elsewhere.
# Override per site in the TOML file with: options = '...'
#BACKUP_MYSQLDUMP_OPTIONS=

# Shell used to run the dump, which is a mysqldump piped into gzip.
# A plain shell reports the status of the last command in a pipeline, so a failed
# mysqldump is masked by the gzip that compressed its partial output and exited 0.
# Needs a shell supporting "set -o pipefail" - leave empty to use plain sh and
# accept that a failed dump will be recorded as a successful backup.
#BACKUP_SHELL=/bin/bash

# Path to gzip executable.
# Compression, not mysqldump, usually decides how long a database backup takes - on a
# 2GB dump, gzip at its default level took two thirds of the total wall time. Pointing
# this at pigz spreads that over every core, or "gzip -1" trades about 20% more storage
# for roughly half the time.
#BACKUP_GZIP_PATH=/bin/gzip

# Path to zip executable
#BACKUP_ZIP_PATH=/usr/bin/zip

# Path to rclone executable
#BACKUP_RCLONE_PATH=/usr/bin/rclone

# rclone remote for storing file backups when using cloud command in format: remote:path_prefix
#BACKUP_CLOUD_REMOTE=

# rclone remote for storing sync backups when using sync command in format: remote:path_prefix
#BACKUP_SYNC_REMOTE=

# Whether to sync a source directory that has become empty.
# sync makes the remote match the source, so an empty source empties the remote copy -
# which is exactly what an unmounted filesystem or a mistyped path looks like. The sync
# command refuses to do that unless this is set.
#BACKUP_SYNC_ALLOW_EMPTY=false

# Directory on the sync remote to move replaced and deleted files into, rather than
# destroying them. Set to a name - "replaced" say - and sync files that go missing or
# change end up under <remote>/<domain>/replaced/<date>/ instead of being deleted, so a
# sync that went wrong costs storage rather than data. Needs its own expiry: a bucket
# lifecycle rule, or a periodic prune. Leave empty to let sync delete outright.
#BACKUP_SYNC_BACKUP_DIR=

# Extra options for the sync command, inserted as written (see the note above).
# Somewhere for --max-delete, --stats or a bandwidth limit. Note that --max-delete is a
# damage limiter rather than a guard: rclone deletes up to the threshold and then errors,
# leaving the remote half mirrored.
#BACKUP_SYNC_OPTIONS=

# How many days to keep local backup files for.
# Files older than this will be removed from 'files' and 'database' directories during a clean command
#BACKUP_KEEPONLY_DAYS=7

# How many days of backups to keep whatever their age.
# A floor under the retention period above: without one, backups failing for longer than
# BACKUP_KEEPONLY_DAYS ends with clean expiring the last ones that worked, and nothing
# left to restore from. Counted in days rather than files, so a run of snapshots taken in
# one afternoon is one day of cover rather than several.
# Set to 0 to expire strictly by age.
#BACKUP_KEEPLEAST_DAYS=3

# Lock file keeping two backup runs off each other.
# One lock covers every backup command, so a stage that overruns its hour holds the next
# one off rather than running over the top of it - the cloud copy will not upload an
# archive that the files backup is still writing. Defaults to .wback.lock at the root of
# the backup destination, which is somewhere this tool can always write, and which sits
# outside the directories that cloud uploads and clean expires. Set an absolute path to
# put it elsewhere - worth doing if the backup destination is a network filesystem.
#BACKUP_LOCK_FILE=/run/lock/wback.lock

# Base path to backup files from
#FILES_ROOT=/srv/www

# Base path to backup files to
#BACKUP_DEST_PATH=backup

# Log channel
#LOG_CHANNEL=stack

# Log stack if using channel "stack"
#LOG_STACK=

# Log storage path
#LOG_STORAGE_PATH=wback.log

# Log level for daily and single log channels
#LOG_LEVEL=debug

# Slack webhook URL for sending logs
#LOG_SLACK_WEBHOOK_URL=

# Log level for slack logs
#LOG_SLACK_LEVEL=critical
